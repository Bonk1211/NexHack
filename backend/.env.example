# Supabase (§15) — get from `get_project_url` / `get_publishable_keys`
SUPABASE_URL=https://ffedvcwvvkdstzlvxxhr.supabase.co
SUPABASE_KEY=

# Model family — LOCKED: DeepSeek V4 (§25 resolved). Two-tier: flash per-step
# vision (comprehend), pro once-per-run synthesis. OpenAI-compatible endpoint.
# Leave LLM_API_KEY empty to run the deterministic offline fallback (no network).
LLM_MODEL_STEP=deepseek-v4-flash
LLM_MODEL_SYNTH=deepseek-v4-pro
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# Determinism (§16)
RUN_SEED=1337

# Per-persona crash-resume checkpoint store (§8 run graph)
CHECKPOINT_DB=checkpoints.sqlite

# WCAG target (§25 open decision) — default 2.2 AA
WCAG_VERSION=2.2

# Alerts (FR-4.3) — optional
SLACK_WEBHOOK_URL=
